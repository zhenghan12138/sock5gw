{
  "db_path": "/var/lib/sock5gw/sock5gw.db",
  "lease_ttl": "24h",
  "api": {
    "listen": "0.0.0.0:8080",
    "client_key": "change-client-token",
    "admin_key": "change-admin-token",
    "trust_proxy_headers": false,
    "geoip_db_path": "/etc/sock5gw/GeoLite2-Country.mmdb"
  },
  "gateway": {
    "listen": "0.0.0.0:15001",
    "transparent_proxy": true,
    "blocked_ports": ["53", "853"],
    "dial_timeout": "10s",
    "idle_timeout": "2m"
  },
  "front_proxy": {
    "enabled": false,
    "protocol": "socks5",
    "address": "127.0.0.1:11080",
    "username": "",
    "password": "",
    "fail_open": false
  },
  "proxy_api": {
    "enabled": false,
    "url": "https://white.1024proxy.com/white/api?region=Rand&num=1&time=10&format=1&type=json",
    "country_param": "region",
    "duration_param": "time"
  },
  "dns": {
    "listen": "0.0.0.0:5353",
    "fake_ip_cidr": "198.18.0.0/15",
    "upstream": "1.1.1.1:53",
    "blocked_qtypes": ["AAAA", "HTTPS", "SVCB"]
  },
  "routing": {
    "enabled": false,
    "geosite_path": "/etc/sock5gw/geosite.dat",
    "default_action": "proxy",
    "rules": [
      { "type": "geosite", "value": "geosite:cn", "action": "direct" },
      { "type": "geosite", "value": "geosite:category-ads-all", "action": "block" },
      { "type": "domain_suffix", "value": "example.com", "action": "proxy" }
    ]
  },
  "health_check": {
    "enabled": false,
    "interval": "30s",
    "timeout": "5s",
    "concurrency": 50,
    "target_host": "example.com",
    "target_port": 80,
    "exit_ip_url": "http://api.ipify.org/",
    "failure_threshold": 3,
    "success_threshold": 2
  },
  "proxies": [
    {
      "id": "proxy-001",
      "address": "203.0.113.10:1080",
      "username": "",
      "password": ""
    }
  ]
}
